{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [".node-version"],
  "globalPassThroughEnv": ["CI"],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": [
        "OASDIFF",
        "DATABASE_ADMIN_URL",
        "DATABASE_OWNER_URL",
        "DATABASE_APP_URL",
        "DATABASE_JOBS_URL",
        "DATABASE_QUEUE_URL"
      ]
    },
    "test:scenarios": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_OWNER_URL",
        "DATABASE_APP_URL",
        "DATABASE_JOBS_URL",
        "DATABASE_QUEUE_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
