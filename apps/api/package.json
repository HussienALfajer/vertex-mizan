    "@nestjs/swagger": "12.0.4",
    "@vertex-mizan/contracts": "workspace:*",
    "@vertex-mizan/db": "workspace:*",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
