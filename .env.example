# Local development settings. Copy to .env (git-ignored); these values are fake and match the
# disposable container of compose.yaml. The repository is public: never commit a real .env.

# Local PostgreSQL 17 (packages/db), started with `docker compose up -d`. `pnpm db:setup-local`
# connects with the admin URL (the container's superuser) and creates the four roles with the
# passwords below and the database. The database tests also use the admin URL, for what only a
# superuser can try (session_replication_role, role attributes), on their throwaway database only.
DATABASE_ADMIN_URL=postgres://postgres:local-only-admin-password@localhost:55417/postgres
# Owner role: runs migrations (`pnpm db:migrate`) and creates the throwaway test databases. Never
# used by the API, the worker or a script (ADR 0008).
DATABASE_OWNER_URL=postgres://mizan_owner:fake-owner-password@localhost:55417/vertex_mizan
# App role: what the API and the worker connect as; row-level security always applies to it.
DATABASE_APP_URL=postgres://mizan_app:fake-app-password@localhost:55417/vertex_mizan
# Jobs role: the worker's cross-company jobs; it cannot bypass RLS and every statement it runs is
# logged without its values.
DATABASE_JOBS_URL=postgres://mizan_jobs:fake-jobs-password@localhost:55417/vertex_mizan
# Queue role: apps/worker runs pg-boss with it, in the pgboss schema only.
DATABASE_QUEUE_URL=postgres://mizan_queue:fake-queue-password@localhost:55417/vertex_mizan
