{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./pnpm-lock.yaml)",
      "Read(**/migrations/meta/**)",
      "Edit(**/migrations/meta/**)",
      "Read(**/routeTree.gen.ts)",
      "Edit(**/routeTree.gen.ts)",
      "Read(**/dist/**)",
      "Read(**/.turbo/**)",
      "Edit(D:/vertex-hub/**)",
      "Write(D:/vertex-hub/**)",
      "Edit(D:/vertex-food/**)",
      "Write(D:/vertex-food/**)",
      "Edit(D:/vertex-shifa/**)",
      "Write(D:/vertex-shifa/**)",
      "Edit(D:/vertex-digital/**)",
      "Write(D:/vertex-digital/**)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh pr merge * --rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(*drizzle-kit push*)",
      "Bash(*drizzle-kit drop*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push -f*)",
      "PowerShell(gh pr merge * --squash*)",
      "PowerShell(gh pr merge * --rebase*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(rm -r*)",
      "PowerShell(*drizzle-kit push*)",
      "PowerShell(*drizzle-kit drop*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-session.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "Git guard"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-guard.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-format.mjs\"",
            "timeout": 30,
            "statusMessage": "Biome"
          }
        ]
      }
    ]
  }
}
