#!/usr/bin/env bash
# Monthly restore drill of mizan.vertexmedia.pro (mizan-restore-drill.timer, on the 5th; ADR 0020,
# "Restore drills"; docs/operations/restore-drills.md), as root:
#   1. the latest backup of the off-server repository (repo2, B2) restored with pgBackRest into a
#      temporary cluster in /var/lib/postgresql/mizan-drill, on 127.0.0.1:5434, with archiving off
#      and its write-ahead log fetched from repo2 only, to the end of the archive;
#   2. recovery waited for until the cluster promotes;
#   3. `drill:check` as vertexmizan with production's environment: every company's chain from its
#      first entry, every entry balanced in both ledgers, and its trial balance against production
#      at the last replayed commit;
#   4. the temporary cluster stopped and removed, whatever happened; on success the `drill` stamp,
#      which the backup monitor requires to be under 35 days old.
# A failure exits non-zero and mizan-restore-drill.service alerts through OnFailure. Read with:
#   journalctl -u mizan-restore-drill -n 100
set -euo pipefail
umask 077
# shellcheck disable=SC1091
. /usr/local/lib/mizan/common.sh

started=$(date +%s)
drill=$MIZAN_DRILL_DIR
port=$MIZAN_DRILL_PORT
pg_ctl() { runuser -u postgres -- "$MIZAN_PG_BIN/pg_ctl" -D "$drill" "$@"; }
drill_psql() {
  runuser -u postgres -- psql -X -q -t -A -v ON_ERROR_STOP=1 -h /var/run/postgresql -p "$port" \
    -d "$MIZAN_DB" -c "$1"
}
log() { echo "[drill $(date -u +%H:%M:%S)] $*"; }

cleanup() {
  if [ -f "$drill/postmaster.pid" ]; then
    pg_ctl -m immediate -w stop >/dev/null 2>&1 || true
  fi
  rm -rf "$drill" "$drill.log"
}

# A drill left behind by a killed run is removed first; a port taken by anything else stops here.
cleanup
if ss -ltn | awk 'NR>1{print $4}' | grep -qx "127.0.0.1:$port"; then
  echo "port $port is taken by another program" >&2
  exit 1
fi
# The restore needs the database's size again, with room to spare.
db_bytes=$(mizan_psql "select pg_database_size('$MIZAN_DB')")
free_bytes=$(df --output=avail -B1 "$(dirname "$drill")" | tail -1 | tr -dc '0-9')
[ "$free_bytes" -gt $((db_bytes * 3)) ] ||
  { echo "only $free_bytes bytes free for a database of $db_bytes" >&2; exit 1; }
trap cleanup EXIT

install -d -o postgres -g postgres -m 700 "$drill"
log "restoring the latest backup of repo2 into $drill"
# archive-get runs without the asynchronous queue: the spool belongs to production's cluster.
runuser -u postgres -- pgbackrest --stanza="$MIZAN_STANZA" --repo=2 --pg1-path="$drill" \
  --type=default --archive-mode=off \
  --recovery-option="restore_command=pgbackrest --stanza=$MIZAN_STANZA --repo=2 --pg1-path=$drill --archive-async=n --log-level-console=warn archive-get %f \"%p\"" \
  --log-level-console=warn restore

# Debian keeps a cluster's settings outside its data directory, so the restore has none of
# production's: the drill gets its own, loopback only, small, never archiving.
cat >"$drill/postgresql.conf" <<EOF
# The restore drill's temporary cluster (deploy/bin/mizan-restore-drill), removed after the drill.
listen_addresses = '127.0.0.1'
port = $port
unix_socket_directories = '/var/run/postgresql'
max_connections = 20
shared_buffers = 256MB
archive_mode = off
ssl = off
logging_collector = off
log_line_prefix = '%m [%p] '
timezone = 'UTC'
EOF
cat >"$drill/pg_hba.conf" <<EOF
local all postgres peer
host $MIZAN_DB mizan_app,mizan_jobs 127.0.0.1/32 scram-sha-256
EOF
: >"$drill/pg_ident.conf"
chown postgres:postgres "$drill/postgresql.conf" "$drill/pg_hba.conf" "$drill/pg_ident.conf"
install -o postgres -g postgres -m 600 /dev/null "$drill.log"

log "starting the temporary cluster on 127.0.0.1:$port"
pg_ctl -l "$drill.log" -w -t 600 start >/dev/null

# Recovery replays the archived log, then promotes at its end. Four hours is the recovery target.
deadline=$(($(date +%s) + 14400))
until [ "$(drill_psql 'select pg_is_in_recovery()' 2>/dev/null)" = f ]; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    tail -n 30 "$drill.log" >&2
    echo "recovery did not finish within four hours" >&2
    exit 1
  fi
  if [ ! -f "$drill/postmaster.pid" ]; then
    tail -n 30 "$drill.log" >&2
    echo "the temporary cluster stopped during recovery" >&2
    exit 1
  fi
  sleep 10
done
restored_at=$(drill_psql "select to_char(pg_last_xact_replay_timestamp() at time zone 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"')")
[ -n "$restored_at" ] || { echo "the restore replayed no transaction" >&2; exit 1; }
log "promoted; the last replayed commit is $restored_at"

# The check runs from the deployed release with production's environment; it reads only, on both
# sides, as the app and jobs roles, whose passwords the restore carries. The paths reach the inner
# shell as its arguments.
# shellcheck disable=SC2016
runuser -u "$MIZAN_USER" -- env -i HOME="/home/$MIZAN_USER" PATH=/usr/local/bin:/usr/bin:/bin \
  LANG=C.UTF-8 bash -c 'cd "$1/current/apps/worker" &&
    exec node --env-file="$2" dist/commands/restore-drill-check.js --restored-port "$3" --restored-at "$4"' \
  drill "$MIZAN_SITE" "$MIZAN_ENV" "$port" "$restored_at"

minutes=$((($(date +%s) - started + 59) / 60))
logger -t mizan-restore-drill "passed: restored to $restored_at from repo2 in $minutes minutes"
log "passed in $minutes minutes"
mizan_stamp drill
