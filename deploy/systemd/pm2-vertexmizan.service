[Unit]
Description=PM2 process manager (mizan.vertexmedia.pro)
Documentation=https://github.com/HussienALfajer/vertex-mizan/blob/main/docs/deployment.md
After=network.target postgresql@17-mizan.service
Wants=postgresql@17-mizan.service
OnFailure=mizan-alert@%n.service

[Service]
Type=forking
User=vertexmizan

LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity

# System paths only: nothing under /root, which vertexmizan cannot read.
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM2_HOME=/home/vertexmizan/.pm2
PIDFile=/home/vertexmizan/.pm2/pm2.pid

# A directory the user can read: starting from /root fails with EACCES (SERVER.md rule 7).
WorkingDirectory=/srv/mizan.vertexmedia.pro

Restart=on-failure
RestartSec=10

ExecStart=/usr/local/bin/pm2 resurrect
ExecReload=/usr/local/bin/pm2 reload all
ExecStop=/usr/local/bin/pm2 kill

[Install]
WantedBy=multi-user.target
