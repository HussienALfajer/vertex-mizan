[Unit]
Description=Monthly restore drill of mizan.vertexmedia.pro (ADR 0020)
Wants=network-online.target
After=network-online.target postgresql@17-mizan.service
OnFailure=mizan-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mizan-restore-drill
UMask=0077
TimeoutStartSec=5h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
