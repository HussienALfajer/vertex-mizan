{
  "name": "vertex-mizan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "test:scenarios": "turbo run test:scenarios",
    "verify": "node scripts/verify.mjs",
    "check:migrations": "node scripts/migration-guard.mjs",
    "check:error-codes": "node scripts/error-codes-guard.mjs",
    "check:openapi": "node scripts/openapi-guard.mjs",
    "check:boot": "node scripts/boot-check.mjs",
    "db:generate": "pnpm --filter @vertex-mizan/db db:generate",
    "db:migrate": "pnpm --filter @vertex-mizan/db db:migrate",
    "db:setup-local": "pnpm --filter @vertex-mizan/db db:setup-local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@vertex-mizan/config": "workspace:*",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
